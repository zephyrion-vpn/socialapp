# =============================================================================
# SocialApp - example environment file. Copy to .env and fill in real values.
# NEVER commit a real .env file. Backend secrets must NEVER be shipped in the
# desktop .exe - the desktop client only needs SOCIALAPP_API_URL.
# =============================================================================

# ----------------------------- BACKEND (apps/server) -------------------------
NODE_ENV=development
# Railway injects PORT automatically in production - do not hardcode it there.
PORT=3000
HOST=0.0.0.0

# PostgreSQL. On Railway use the reference: ${{ Postgres.DATABASE_URL }}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/socialapp?schema=public

# Optional Redis service (caching for trends/feed + counters).
# On Railway use the reference: ${{ Redis.REDIS_URL }}
REDIS_URL=

# Auth. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-string-at-least-32-characters-long
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# API protection
CORS_ORIGINS=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
TRUST_PROXY=1
LOG_LEVEL=info
PUBLIC_APP_URL=http://localhost:3000

# --------------------- OBJECT STORAGE (media, S3 compatible) -----------------
# Media is NEVER stored on the Railway filesystem (ephemeral).
# Works with AWS S3, Cloudflare R2, Backblaze B2, MinIO, Supabase Storage...
# STORAGE_PROVIDER=none disables uploads and returns a clear 503 error.
STORAGE_PROVIDER=none
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=true

# ----------------------------- DESKTOP (apps/desktop) ------------------------
# Baked into the .exe at build time (electron main process only).
# Development:
SOCIALAPP_API_URL=http://localhost:3000
# Production example:
# SOCIALAPP_API_URL=https://socialapp-api-production.up.railway.app
