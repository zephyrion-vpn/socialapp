{
  "name": "@socialapp/api-client",
  "version": "1.0.0",
  "private": true,
  "description": "Typed HTTPS client for the SocialApp REST API (used by the Electron desktop client)",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit --declaration false --declarationMap false"
  },
  "dependencies": {
    "@socialapp/shared": "*"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
