# Desktop build configuration.
# The value is baked into the build as the DEFAULT API URL; users can still
# override it at runtime in Settings -> Server. No secrets belong in here:
# everything in this file ends up inside the shipped .exe.

# Development
SOCIALAPP_API_URL=http://localhost:3000

# Production example (Railway)
# SOCIALAPP_API_URL=https://your-production-api.up.railway.app
