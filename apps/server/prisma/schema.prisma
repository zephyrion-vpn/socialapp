// SocialApp database schema (PostgreSQL).
// Table and column names use the Prisma default (quoted PascalCase / camelCase),
// which is what the hand written SQL migrations create as well.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MediaType {
  IMAGE
  GIF
  VIDEO
}

enum NotificationType {
  LIKE
  REPLY
  REPOST
  FOLLOW
  MENTION
  QUOTE
  SYSTEM
}

enum PostVisibility {
  PUBLIC
  FOLLOWERS
  UNLISTED
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(320)
  username     String    @unique @db.VarChar(20)
  passwordHash String
  isActive     Boolean   @default(true)
  isVerified   Boolean   @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  profile               Profile?
  posts                 Post[]                    @relation("PostAuthor")
  likes                 Like[]
  reposts               Repost[]
  bookmarks             Bookmark[]
  replyEdges            Reply[]                   @relation("ReplyAuthor")
  following             Follow[]                  @relation("FollowFollower")
  followers             Follow[]                  @relation("FollowFollowing")
  notificationsReceived Notification[]            @relation("NotificationRecipient")
  notificationsSent     Notification[]            @relation("NotificationActor")
  blocksMade            Block[]                   @relation("BlockBlocker")
  blocksReceived        Block[]                   @relation("BlockBlocked")
  mutesMade             Mute[]                    @relation("MuteMuter")
  mutesReceived         Mute[]                    @relation("MuteMuted")
  conversations         ConversationParticipant[]
  directMessages        DirectMessage[]           @relation("DirectMessageSender")
  sessions              Session[]
  passwordResetTokens   PasswordResetToken[]

  @@index([createdAt])
}

model Profile {
  id          String  @id @default(uuid()) @db.Uuid
  userId      String  @unique @db.Uuid
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String  @db.VarChar(50)
  bio         String? @db.VarChar(280)
  avatarUrl   String?
  bannerUrl   String?
  location    String? @db.VarChar(64)
  website     String? @db.VarChar(200)

  // Denormalised counters kept in sync inside transactions.
  followersCount Int @default(0)
  followingCount Int @default(0)
  postsCount     Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([displayName])
}

model Post {
  id         String         @id @default(uuid()) @db.Uuid
  authorId   String         @db.Uuid
  author     User           @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  content    String         @db.VarChar(500)
  visibility PostVisibility @default(PUBLIC)

  // Threading: parentId = direct parent, rootId = first post of the thread.
  parentId    String? @db.Uuid
  parent      Post?   @relation("PostReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Post[]  @relation("PostReplies")
  rootId      String? @db.Uuid
  root        Post?   @relation("PostThread", fields: [rootId], references: [id], onDelete: Cascade)
  threadPosts Post[]  @relation("PostThread")

  // Quote posts (repost with comment).
  quotedPostId String? @db.Uuid
  quotedPost   Post?   @relation("PostQuotes", fields: [quotedPostId], references: [id], onDelete: SetNull)
  quotedBy     Post[]  @relation("PostQuotes")

  likeCount     Int   @default(0)
  replyCount    Int   @default(0)
  repostCount   Int   @default(0)
  bookmarkCount Int   @default(0)
  viewCount     Int   @default(0)
  /// Cached engagement score - the ranking feed decays it by age at query time.
  score         Float @default(0)

  isDeleted Boolean   @default(false)
  editedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  media         PostMedia[]
  likes         Like[]
  reposts       Repost[]
  bookmarks     Bookmark[]
  hashtags      PostHashtag[]
  notifications Notification[]
  replyEdges    Reply[]       @relation("ReplyParent")
  replyEdge     Reply?        @relation("ReplyChild")

  @@index([authorId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([parentId, createdAt])
  @@index([rootId])
  @@index([quotedPostId])
  @@index([isDeleted, createdAt(sort: Desc)])
  @@index([score(sort: Desc), createdAt(sort: Desc)])
}

model PostMedia {
  id         String    @id @default(uuid()) @db.Uuid
  postId     String    @db.Uuid
  post       Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  type       MediaType @default(IMAGE)
  /// Object storage key (S3 / R2). Files never live on the app filesystem.
  storageKey String    @db.VarChar(512)
  url        String
  mimeType   String?   @db.VarChar(128)
  sizeBytes  Int?
  width      Int?
  height     Int?
  altText    String?   @db.VarChar(420)
  position   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([postId, position])
}

model Like {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String   @db.Uuid
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model Repost {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String   @db.Uuid
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

/// Explicit reply edge (parent post -> reply post). Kept next to Post.parentId
/// so reply timelines and counters can be resolved without recursive queries.
model Reply {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  post      Post     @relation("ReplyParent", fields: [postId], references: [id], onDelete: Cascade)
  replyId   String   @unique @db.Uuid
  reply     Post     @relation("ReplyChild", fields: [replyId], references: [id], onDelete: Cascade)
  authorId  String   @db.Uuid
  author    User     @relation("ReplyAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
  @@index([authorId, createdAt(sort: Desc)])
}

model Follow {
  id          String   @id @default(uuid()) @db.Uuid
  followerId  String   @db.Uuid
  follower    User     @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String   @db.Uuid
  following   User     @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId, createdAt(sort: Desc)])
  @@index([followerId, createdAt(sort: Desc)])
}

model Bookmark {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String   @db.Uuid
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([postId])
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  recipientId String           @db.Uuid
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String?          @db.Uuid
  actor       User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  type        NotificationType
  postId      String?          @db.Uuid
  post        Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  isRead      Boolean          @default(false)
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  @@index([recipientId, createdAt(sort: Desc)])
  @@index([recipientId, isRead])
  @@index([actorId])
  @@index([postId])
}

/// One to one direct message thread.
///
/// `pairKey` is the two participant ids sorted and joined, so the unique index
/// makes a duplicate thread between the same two people impossible even under
/// concurrent "start conversation" requests.
model Conversation {
  id                  String    @id @default(uuid()) @db.Uuid
  pairKey             String    @unique @db.VarChar(80)
  lastMessageAt       DateTime?
  lastMessagePreview  String?   @db.VarChar(160)
  lastMessageSenderId String?   @db.Uuid
  messageCount        Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  participants ConversationParticipant[]
  messages     DirectMessage[]

  @@index([lastMessageAt(sort: Desc)])
}

/// Per side state of a conversation (unread counter, mute, archive).
model ConversationParticipant {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  unreadCount    Int          @default(0)
  lastReadAt     DateTime?
  isMuted        Boolean      @default(false)
  isArchived     Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId, isArchived])
}

model DirectMessage {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String       @db.Uuid
  sender         User         @relation("DirectMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  content        String       @db.VarChar(2000)
  isDeleted      Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId, createdAt(sort: Desc)])
}

model Hashtag {
  id         String        @id @default(uuid()) @db.Uuid
  tag        String        @unique @db.VarChar(64)
  postCount  Int           @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime      @default(now())
  posts      PostHashtag[]

  @@index([postCount(sort: Desc)])
  @@index([lastUsedAt(sort: Desc)])
}

model PostHashtag {
  postId    String   @db.Uuid
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtagId String   @db.Uuid
  hashtag   Hashtag  @relation(fields: [hashtagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, hashtagId])
  @@index([hashtagId, createdAt(sort: Desc)])
}

model Block {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @db.Uuid
  blocker   User     @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String   @db.Uuid
  blocked   User     @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Mute {
  id        String   @id @default(uuid()) @db.Uuid
  muterId   String   @db.Uuid
  muter     User     @relation("MuteMuter", fields: [muterId], references: [id], onDelete: Cascade)
  mutedId   String   @db.Uuid
  muted     User     @relation("MuteMuted", fields: [mutedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([muterId, mutedId])
  @@index([mutedId])
}

/// Refresh token family. Only the SHA-256 hash of the refresh token is stored.
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique @db.VarChar(128)
  userAgent        String?   @db.VarChar(400)
  ipAddress        String?   @db.VarChar(64)
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @db.VarChar(128)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
